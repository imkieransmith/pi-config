{
  "name": "pi-extensions",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test:advisor": "node --import ./agent/extensions/tests/register.mjs --test agent/extensions/advisor/brief.test.ts agent/extensions/tests/advisor.test.ts",
    "test:context": "node --test agent/extensions/context/appendix.test.ts",
    "test:evidence": "node --test agent/extensions/evidence/core.test.ts",
    "test:security": "node --test agent/extensions/security/policy.test.ts",
    "test": "node --import ./agent/extensions/tests/register.mjs --test \"agent/extensions/**/*.test.ts\"",
    "test:integration": "node --import ./agent/extensions/tests/register.mjs --test agent/extensions/tests/integration.test.mjs",
    "typecheck": "node agent/extensions/tests/typecheck.mjs"
  },
  "pi": {
    "extensions": [
      "./agent/extensions"
    ],
    "skills": [
      "./agent/skills"
    ]
  },
  "dependencies": {
    "@shikijs/cli": "^4.0.2",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "typebox": "^1.1.24",
    "typescript": "^7.0.2"
  }
}
